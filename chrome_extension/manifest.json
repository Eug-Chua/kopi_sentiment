{
  "manifest_version": 3,
  "name": "Kopi Sentiment Capture",
  "version": "0.1.0",
  "description": "Capture the active Reddit listing for a local Kopi Sentiment run.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://*.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Capture for Kopi Sentiment",
    "default_popup": "popup.html"
  }
}
